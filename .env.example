# Published multi-architecture image. Change this to a version tag for reproducible deployments.
DASHBOARD_IMAGE=ghcr.io/gexiaobin/home-server-dashboard:latest

# Host-side web binding. Use 127.0.0.1 when all access goes through DSM reverse proxy.
BIND_ADDRESS=0.0.0.0
APP_PORT=3000

# Synology persistent data and monitored storage paths.
DATA_PATH=/volume1/docker/home-server-dashboard/data
HOST_STORAGE_PATH=/volume1

TZ=Asia/Shanghai

# Timeout for HTTP/TCP service probes, in milliseconds.
SERVICE_CHECK_TIMEOUT_MS=5000

# Optional application-level Basic Auth. Set both values or leave both empty.
# Always use HTTPS when enabling Basic Auth.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

