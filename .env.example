# Published multi-architecture image. Use a version tag for reproducible deployments.
DASHBOARD_IMAGE=ghcr.io/gexiaobin/home-server-dashboard:latest

# Host-side web binding. Use 127.0.0.1 when all access goes through a reverse proxy.
BIND_ADDRESS=0.0.0.0
APP_PORT=3000

# PostgreSQL is required by the Docker deployment. Set DATABASE_URL directly, or use
# docker-compose.database-file.yml with a protected one-line URI file.
STORAGE_BACKEND=postgresql
DATABASE_URL=
DATABASE_URL_FILE=
DATABASE_URL_FILE_PATH=./secrets/database_url
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=5000

# Legacy JSON migration path and monitored host storage path.
DATA_PATH=./data
HOST_STORAGE_PATH=/volume1
# Friendly label shown in the dashboard instead of the container ID.
HOST_DISPLAY_NAME=Synology DS920+

# Total timeout for the optional Docker API container query, in milliseconds.
DOCKER_API_TIMEOUT_MS=3000

TZ=Asia/Shanghai

# Timeout for HTTP/TCP service probes, in milliseconds.
SERVICE_CHECK_TIMEOUT_MS=5000

# Timeout for fetching service favicons, in milliseconds.
SERVICE_ICON_TIMEOUT_MS=5000
# Keep false unless a trusted internal service uses a self-signed or expired certificate.
SERVICE_ICON_ALLOW_INSECURE_TLS=false

# Optional application-level Basic Auth. Set both values or leave both empty.
# Always use HTTPS when enabling Basic Auth.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
